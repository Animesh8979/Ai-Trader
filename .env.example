# =============================================================================
#  Godmode Trading Agent — environment file (EXAMPLE)
# -----------------------------------------------------------------------------
#  Copy this file to ".env" and fill in the values. The setup wizard
#  (`godmode setup`) does this for you automatically — you usually don't need
#  to edit this by hand.
#
#  NEVER share your .env or commit it to git. It contains your secret keys.
# =============================================================================

# --- App mode -------------------------------------------------------------
# paper   = simulated money, real prices (SAFE, the default)
# backtest= replay historical data only
# live    = REAL money (locked behind extra confirmations; do not use yet)
GODMODE_MODE=paper
GODMODE_ENV=dev

# --- LLM provider keys (you only need ONE to start) -----------------------
# Claude (Anthropic):  https://console.anthropic.com/  -> API Keys
ANTHROPIC_API_KEY=
# Gemini (Google AI Studio):  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# OpenAI (optional):  https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Local models via Ollama (free, optional):  https://ollama.com
OLLAMA_API_BASE=http://localhost:11434

# --- Crypto TESTNET keys (free fake money, real prices) -------------------
# Binance Spot Testnet:  https://testnet.binance.vision/  (log in with GitHub)
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# Bybit Testnet:  https://testnet.bybit.com/  -> API Management
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# --- Optional phone/email alerts (Phase 3) --------------------------------
# Create a bot with @BotFather on Telegram to get a token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
